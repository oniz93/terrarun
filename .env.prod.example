# Production Environment Variables
# Copy to .env and fill in real values

# Domain
DOMAIN=terrarun.app
EMAIL=admin@terrarun.app

# Database
DB_PASSWORD=generate_a_strong_random_password_here

# Redis
REDIS_PASSWORD=generate_a_strong_redis_password_here

# Storage (change access/secret keys)
STORAGE_ACCESS_KEY=terrarun_prod
STORAGE_SECRET_KEY=generate_a_strong_storage_secret_here

# Auth (generate random secrets)
JWT_SECRET=generate_a_strong_jwt_secret_here
PHONE_HASH_PEPPER=generate_a_phone_pepper_here

# OAuth (get from Google Cloud Console)
GOOGLE_CLIENT_ID=

# OAuth Apple (get from Apple Developer Console)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CLIENT_ID=

# Mapbox (get from mapbox.com)
MAPBOX_TOKEN=
